# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Cal.com booking embed
# Create a free account at https://cal.com, set up an event type,
# then paste your event link here (e.g. "yourname/consultation")
NEXT_PUBLIC_CAL_LINK=your-username/your-event-slug

# Resend (contact form emails to sysplatco@gmail.com)
# From must be on the verified sysplat.com domain
RESEND_API_KEY=re_your_sysplat_sending_key
CONTACT_FROM_EMAIL="SYSPLAT <contact@sysplat.com>"
CONTACT_TO_EMAIL=sysplatco@gmail.com
